generated/
*.png
*.jpg
*.jpeg

# Frontend (keep source; ignore install/build artifacts)
frontend/node_modules/
frontend/dist/
frontend/.npm-cache/
.npm-cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node
node_modules/
frontend/node_modules/

# Package caches
.pip-cache/
.npm-cache/
